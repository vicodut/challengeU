  "info": {
    "title": "ChallengeU API",
    "description": "Coaching session booking",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "basic": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "displayName"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:challengeu:problem:invalid-credentials"
          },
          "title": {
            "type": "string",
            "example": "Unauthorized"
          },
          "status": {
            "type": "number",
            "example": 401
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code",
            "example": "INVALID_CREDENTIALS"
          },
          "detail": {
            "type": "string",
            "example": "Missing or invalid credentials"
          },
          "errors": {
            "description": "Present on validation errors",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "coach",
              "admin"
            ]
          },
          "timeZone": {
            "type": "string",
            "example": "America/Toronto",
            "description": "IANA time zone"
          }
        },
        "required": [
          "userId",
          "username",
          "displayName",
          "role",
          "timeZone"
        ]
      },
      "CoachResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "example": "Coach A"
          },
          "timeZone": {
            "type": "string",
            "example": "America/Toronto",
            "description": "IANA time zone"
          }
        },
        "required": [
          "id",
          "displayName",
          "timeZone"
        ]
      },
      "CoachListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoachResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ListedBlockResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "number",
            "enum": [
              30,
              60
            ]
          },
          "bookedSessionCount": {
            "type": "number",
            "minimum": 0,
            "description": "Sessions booked in this block"
          }
        },
        "required": [
          "id",
          "startsAt",
          "durationMinutes",
          "bookedSessionCount"
        ]
      },
      "PublishBlockRequest": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "example": "2030-01-07T14:00:00.000Z",
            "description": "UTC instant, on :00 or :30"
          },
          "durationMinutes": {
            "type": "number",
            "enum": [
              30,
              60
            ],
            "description": "Block length in minutes"
          }
        },
        "required": [
          "startsAt",
          "durationMinutes"
        ]
      },
      "BlockResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "number",
            "enum": [
              30,
              60
            ]
          }
        },
        "required": [
          "id",
          "startsAt",
          "durationMinutes"
        ]
      },
      "ProgramResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Academic Success"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ProgramListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProgramResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateProgramRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Academic Success",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "ProgramMemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "example": "Coach A"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "ProgramDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Academic Success"
          },
          "coaches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProgramMemberResponse"
            }
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProgramMemberResponse"
            }
          }
        },
        "required": [
          "id",
          "name",
          "coaches",
          "students"
        ]
      },
      "AssignCoachRequest": {
        "type": "object",
        "properties": {
          "coachId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "coachId"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Server time (from the Clock port)"
          }
        },
        "required": [
          "status",
          "database",
          "checkedAt"
        ]
      }
    }
  }
}
