{
  "name": "challengeu",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.15"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "test": "node scripts/run.mjs test",
    "build": "node scripts/run.mjs build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "openapi": "node scripts/run.mjs openapi",
