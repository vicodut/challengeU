# Copied to .env automatically by `pnpm dev` / `pnpm test`, which also derives
# per-worktree ports and a unique compose project name. Defaults shown here.
COMPOSE_PROJECT_NAME=challengeu
DB_PORT=5432
DB_USER=challengeu
DB_PASSWORD=challengeu
DB_NAME=challengeu_dev
DB_NAME_TEST=challengeu_test
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgres://challengeu:challengeu@localhost:5432/challengeu_dev
TEST_DATABASE_URL=postgres://challengeu:challengeu@localhost:5432/challengeu_test
