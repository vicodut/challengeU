# Keys only. The real `.env` is generated automatically by `pnpm dev` / `pnpm test`
# (scripts/env.mjs) with per-worktree values: a unique compose project name and free
# DB/API/web ports. Do not copy this file; the values below are illustrative.
COMPOSE_PROJECT_NAME=challengeu-<hash>
DB_PORT=15000
DB_USER=challengeu
DB_PASSWORD=challengeu
DB_NAME=challengeu_dev
DB_NAME_TEST=challengeu_test
API_PORT=13000
WEB_PORT=14000
DATABASE_URL=postgres://challengeu:challengeu@localhost:15000/challengeu_dev
TEST_DATABASE_URL=postgres://challengeu:challengeu@localhost:15000/challengeu_test
